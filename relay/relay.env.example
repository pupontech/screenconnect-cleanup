# Copy to /etc/screenconnect-report-relay/relay.env during server setup.
# Values below are placeholders, not usable credentials.
RELAY_TOKEN_SHA256=[REDACTED]
AGE_RECIPIENT=[REDACTED]
STORAGE_DIR=/var/lib/screenconnect-report-relay/inbox
BIND_HOST=127.0.0.1
BIND_PORT=9127
RETENTION_SECONDS=2592000
MAX_UPLOAD_BYTES=52428800
MAX_UNCOMPRESSED_BYTES=262144000
MAX_ZIP_ENTRIES=1024
AGE_BINARY=/usr/bin/age
