<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1200" Height="800">
  <UserControl.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#1A1A1A"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#0A6EBE"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </UserControl.Resources>
  <Grid Background="#F2F2F2" Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" FontSize="22" FontWeight="Bold" Foreground="#0A6EBE" Text="Scanners"/>
    <DataGrid Grid.Row="1" x:Name="GrdScanners" AutoGenerateColumns="True" Margin="0,10,0,0"/>
    <StackPanel Grid.Row="2">
      <TextBlock x:Name="TxtScannerStatus" Text="Status: idle" Margin="2"/>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BtnRunScanner" Content="Run Selected"/>
        <Button x:Name="BtnAttendedLaunch" Content="Launch Attended"/>
        <TextBox x:Name="TxtTimeout" Width="80" Text="120" VerticalAlignment="Center"/>
        <TextBlock Text="timeout (minutes)" VerticalAlignment="Center" Margin="4"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
