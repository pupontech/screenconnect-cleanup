<Window x:Class="ScreenConnectCleanup.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ScreenConnectCleanup.Gui.ViewModels"
        xmlns:views="clr-namespace:ScreenConnectCleanup.Gui.Views"
        Title="ScreenConnect Cleanup — Detect-only Inspection"
        Height="760" Width="1120" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        TextOptions.TextFormattingMode="Display">
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Alt" Command="{Binding NavigateHomeCommand}" />
        <KeyBinding Key="D2" Modifiers="Alt" Command="{Binding NavigateInvestigationCommand}" />
        <KeyBinding Key="D3" Modifiers="Alt" Command="{Binding NavigateReviewCommand}" />
        <KeyBinding Key="D4" Modifiers="Alt" Command="{Binding NavigateResultsCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding NavigateBackCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvestigationViewModel}">
            <views:InvestigationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReviewViewModel}">
            <views:ReviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultsViewModel}">
            <views:ResultsView />
        </DataTemplate>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Padding="12,8"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                        KeyboardNavigation.TabNavigation="Once">
                <Button Content="_Advanced mode" Command="{Binding Investigation.UseAdvancedModeCommand}"
                        AutomationProperties.Name="Use Advanced mode" Margin="0,0,8,0" Padding="16,8">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Investigation.IsAdvancedMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="_Simple mode" Command="{Binding Investigation.UseSimpleModeCommand}"
                        AutomationProperties.Name="Use Simple mode" Margin="0,0,8,0" Padding="16,8">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Investigation.IsAdvancedMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Rectangle Width="1" Height="28" Margin="0,0,8,0"
                           Fill="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Investigation.IsAdvancedMode}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="_Home" Command="{Binding NavigateHomeCommand}"
                            AutomationProperties.Name="Navigate to Home view" ToolTip="Alt+1"
                            Margin="0,0,8,0" Padding="16,8" />
                    <Button Content="_Investigation" Command="{Binding NavigateInvestigationCommand}"
                            AutomationProperties.Name="Navigate to Investigation view" ToolTip="Alt+2"
                            Margin="0,0,8,0" Padding="16,8" />
                    <Button Content="_Review" Command="{Binding NavigateReviewCommand}"
                            AutomationProperties.Name="Navigate to Review view" ToolTip="Alt+3"
                            Margin="0,0,8,0" Padding="16,8" />
                    <Button Content="_Results" Command="{Binding NavigateResultsCommand}"
                            AutomationProperties.Name="Navigate to Results view" ToolTip="Alt+4"
                            Margin="0,0,8,0" Padding="16,8" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="12,7"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Investigation.IsAdvancedMode}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="_Back" Command="{Binding NavigateBackCommand}"
                        AutomationProperties.Name="Navigate back to the previous view" ToolTip="Alt+Left"
                        Padding="14,5" />
                <TextBlock Text="DETECT-ONLY INSPECTION — writes output artifacts and may write a detector transcript to the current user's Desktop. Full Investigation is unavailable because its snapshot may load and unload the Amcache registry hive; this GUI does not perform cleanup, removal, scanning, AV uninstall, or upload."
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           AutomationProperties.Name="Detect-only inspection safety notice" />
            </DockPanel>
        </Border>

        <ContentControl Content="{Binding CurrentViewModel}"
                        AutomationProperties.Name="Current application view"
                        KeyboardNavigation.TabNavigation="Local" />
    </DockPanel>
</Window>
