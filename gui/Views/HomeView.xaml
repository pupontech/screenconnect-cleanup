<UserControl x:Class="ScreenConnectCleanup.Gui.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="{Binding Title}" Style="{DynamicResource ViewTitleStyle}" />
            <Border Style="{DynamicResource PreviewBannerStyle}" AutomationProperties.Name="Synthetic data notice">
                <StackPanel>
                    <TextBlock Text="Static synthetic preview" FontWeight="SemiBold" />
                    <TextBlock Text="This Phase 1 shell reads no device, run, or incident data. Values below are sample-only."
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Sample system context" Style="{DynamicResource SectionHeaderStyle}" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Padding="14" Margin="0,0,8,8"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <StackPanel>
                        <TextBlock Text="Computer name" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ComputerName}" Margin="0,4,0,0"
                                   AutomationProperties.Name="Synthetic computer name" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Padding="14" Margin="8,0,0,8"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <StackPanel>
                        <TextBlock Text="Operating system" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding OperatingSystem}" Margin="0,4,0,0"
                                   AutomationProperties.Name="Synthetic operating system" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Padding="14" Margin="0,0,8,8"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <StackPanel>
                        <TextBlock Text="Administrator status" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding IsAdministrator}" Margin="0,4,0,0"
                                   AutomationProperties.Name="Synthetic administrator status" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="14" Margin="8,0,0,8"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <StackPanel>
                        <TextBlock Text="Disk space" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding FreeSpace}" Margin="0,4,0,0"
                                   AutomationProperties.Name="Synthetic disk space status" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="0" Padding="14" Margin="0,0,8,0"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <StackPanel>
                        <TextBlock Text="Version" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ToolVersion}" Margin="0,4,0,0"
                                   AutomationProperties.Name="Synthetic tool version" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Padding="14" Margin="8,0,0,0"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <StackPanel>
                        <TextBlock Text="Incident date" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding IncidentDate, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue='Not supplied in synthetic preview'}"
                                   Margin="0,4,0,0" AutomationProperties.Name="Synthetic incident date" />
                    </StackPanel>
                </Border>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                        KeyboardNavigation.TabNavigation="Once">
                <Button Content="Full Investigation"
                        Command="{Binding DataContext.NavigateInvestigationCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        IsEnabled="False" AutomationProperties.Name="Full Investigation preview navigation"
                        Margin="0,0,8,0" Padding="12,7" />
                <Button Content="Detect Only"
                        Command="{Binding DataContext.NavigateInvestigationCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        IsEnabled="False" AutomationProperties.Name="Detect Only preview navigation"
                        Margin="0,0,8,0" Padding="12,7" />
                <Button Content="Previous Runs"
                        Command="{Binding DataContext.NavigateResultsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        IsEnabled="False" AutomationProperties.Name="Previous Runs preview navigation"
                        Padding="12,7" />
            </StackPanel>
            <TextBlock Text="Recent synthetic runs" Style="{DynamicResource SectionHeaderStyle}" />
            <ItemsControl ItemsSource="{Binding RecentRuns}" AutomationProperties.Name="Synthetic run history">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,8"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding RunId}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ComputerName}" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OverallStatus}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Sample only" VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
