<UserControl x:Class="ScreenConnectCleanup.Gui.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="{Binding Title}" Style="{DynamicResource ViewTitleStyle}" />
            <Border Style="{DynamicResource PreviewBannerStyle}" AutomationProperties.Name="Synthetic results notice">
                <StackPanel>
                    <TextBlock Text="No real results are connected" FontWeight="SemiBold" />
                    <TextBlock Text="This screen demonstrates fail-closed incomplete states. No report, run folder, scanner output, or share link exists in Phase 1."
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Sample run summary" Style="{DynamicResource SectionHeaderStyle}" />
            <Border Padding="14" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Results.RunId}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Results.ComputerName}" Margin="0,3,0,0" />
                    <TextBlock Text="Synthetic fixture; no run was started." Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Outcome states" Style="{DynamicResource SectionHeaderStyle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Padding="12" Margin="0,0,6,6"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <StackPanel><TextBlock Text="Detection" FontWeight="SemiBold" /><TextBlock Text="{Binding Results.Detection.Status}" /></StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Padding="12" Margin="6,0,0,6"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <StackPanel><TextBlock Text="Removal" FontWeight="SemiBold" /><TextBlock Text="{Binding Results.Removal.Status}" /></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Padding="12" Margin="0,0,6,6"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <StackPanel><TextBlock Text="Scanner" FontWeight="SemiBold" /><TextBlock Text="{Binding Results.Scanner.Status}" /></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="12" Margin="6,0,0,6"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <StackPanel><TextBlock Text="Verification" FontWeight="SemiBold" /><TextBlock Text="{Binding Results.Verification.Status}" /></StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="0" Padding="12" Margin="0,0,6,0"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <StackPanel><TextBlock Text="Report" FontWeight="SemiBold" /><TextBlock Text="{Binding Results.Report.Status}" /></StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Padding="12" Margin="6,0,0,0"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <StackPanel><TextBlock Text="Sanitized share" FontWeight="SemiBold" /><TextBlock Text="{Binding Results.SanitizedShare.Status}" /></StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Evidence availability" Style="{DynamicResource SectionHeaderStyle}" />
            <TextBlock Text="{Binding Results.Detection.InstanceCount, StringFormat=Sample instance count: {0}}"
                       AutomationProperties.Name="Synthetic detection instance count" />
            <TextBlock Text="Report path: not available" Margin="0,3,0,0" />
            <TextBlock Text="Share link: not available" Margin="0,3,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
