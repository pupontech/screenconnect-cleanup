<UserControl x:Class="ScreenConnectCleanup.Gui.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="{Binding Title}" Style="{DynamicResource ViewTitleStyle}" />
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSyntheticPreview}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Padding="14,10" Margin="0,0,0,18"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                        BorderThickness="1"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <StackPanel>
                        <TextBlock Text="Read-only current findings" FontWeight="SemiBold" />
                        <TextBlock Text="Real run data is displayed as read-only evidence. This view cannot approve, decline, or perform removal."
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding CurrentRunFindingsStatus}" TextWrapping="Wrap" Margin="0,0,0,12"
                           AutomationProperties.Name="Current run findings status" />
                <TextBlock Text="{Binding CurrentRunDisplayNote}" TextWrapping="Wrap" Margin="0,0,0,8"
                           AutomationProperties.Name="Read-only findings display limit" />

                <TextBlock Text="Validated ScreenConnect findings" Style="{DynamicResource SectionHeaderStyle}" />
                <ItemsControl ItemsSource="{Binding CurrentRunInstances}"
                              AutomationProperties.Name="Validated ScreenConnect findings">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" Margin="0,0,0,8"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="ScreenConnect finding data" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               FontFamily="Consolas" AutomationProperties.Name="ScreenConnect finding details" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Other remote-access targets" Style="{DynamicResource SectionHeaderStyle}" />
                <ItemsControl ItemsSource="{Binding CurrentRunOtherTargets}"
                              AutomationProperties.Name="Validated other remote-access targets">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" Margin="0,0,0,8"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding Hits}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Findings validation issues" Style="{DynamicResource SectionHeaderStyle}" />
                <ItemsControl ItemsSource="{Binding CurrentRunFindingsIssues}"
                              AutomationProperties.Name="Findings validation issues">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Approval and decline controls are unavailable for real runs."
                           TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.Name="Real run review is read-only" />
            </StackPanel>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSyntheticPreview}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
            <Border Style="{DynamicResource PreviewBannerStyle}" AutomationProperties.Name="Synthetic review notice">
                <StackPanel>
                    <TextBlock Text="Read-only synthetic findings" FontWeight="SemiBold" />
                    <TextBlock Text="Review controls below only change an in-memory preview decision. They do not approve or perform removal."
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Sample ScreenConnect instances" Style="{DynamicResource SectionHeaderStyle}" />
            <ItemsControl ItemsSource="{Binding ScreenConnectInstances}" AutomationProperties.Name="Synthetic ScreenConnect instances">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14" Margin="0,0,0,10"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Identifier}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RelayHost}" Margin="0,4,0,0"
                                           AutomationProperties.Name="Synthetic relay host" />
                                <TextBlock Text="{Binding SessionType}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding InstallDir}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding ServerKeyFingerprint}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBlock Text="Install date (UTC)" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding InstallDirCreatedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='Not supplied in synthetic fixture'}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           AutomationProperties.Name="Synthetic install date" />
                                <TextBlock Text="Executable file" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding File}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           AutomationProperties.Name="Synthetic executable file path" />
                                <TextBlock Text="Evidence basis" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <ItemsControl ItemsSource="{Binding Sources}"
                                              AutomationProperties.Name="Synthetic evidence basis" />
                                <TextBlock Text="Custom properties" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <ItemsControl ItemsSource="{Binding CustomProperties}"
                                              AutomationProperties.Name="Synthetic custom properties">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Parsing warnings" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <ItemsControl ItemsSource="{Binding ParseIssues}"
                                              AutomationProperties.Name="Synthetic parsing warnings" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Other remote-access targets (detect-only sample)" Style="{DynamicResource SectionHeaderStyle}" />
            <ItemsControl ItemsSource="{Binding OtherTargets}" AutomationProperties.Name="Synthetic other targets">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,8"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding Hits}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Preview-only decision controls" Style="{DynamicResource SectionHeaderStyle}" />
            <TextBlock Text="{Binding ApprovalStatus}" TextWrapping="Wrap" Margin="0,0,0,10"
                       AutomationProperties.Name="Synthetic review decision status" />
            <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once">
                <Button Content="Preview _approval" Command="{Binding ApproveAllInstancesCommand}"
                        AutomationProperties.Name="Select synthetic preview approval"
                        IsEnabled="{Binding IsSyntheticPreview}"
                        Margin="0,0,8,0" Padding="12,7" />
                <Button Content="Preview _decline" Command="{Binding DeclineAllInstancesCommand}"
                        AutomationProperties.Name="Select synthetic preview decline"
                        IsEnabled="{Binding IsSyntheticPreview}"
                        Margin="0,0,8,0" Padding="12,7" />
                <Button Content="_Reset preview" Command="{Binding ResetDecisionCommand}"
                        AutomationProperties.Name="Reset synthetic preview decision"
                        IsEnabled="{Binding IsSyntheticPreview}" Padding="12,7" />
            </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
